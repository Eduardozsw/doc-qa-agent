# Chave da OpenAI (usada para embeddings text-embedding-3-small e para o LLM gpt-4o-mini)
OPENAI_API_KEY=sk-...

# Segredo usado para assinar os JWT (HS256). Troque por uma string longa aleatória.
JWT_SECRET=troque-por-uma-string-longa-aleatoria

# Postgres com extensão pgvector. No docker compose essas duas variáveis são
# sobrescritas automaticamente (host passa a ser "postgres"/"redis"); os valores
# abaixo valem para rodar o backend nativamente (uv run uvicorn ...).
DATABASE_URL=postgresql://docqa:docqa@localhost:5432/docqa
REDIS_URL=redis://localhost:6379

# Origens autorizadas pelo CORS (frontend em dev e frontend via compose/nginx)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Usuário de demonstração, criado automaticamente no boot da API
DEMO_USER_EMAIL=demo@local
DEMO_USER_PASSWORD=demo1234
